# GrammarCheck Configuration
# Copy to .env and edit as needed

# Ollama
GRAMMARCHECK_OLLAMA_URL=http://localhost:11434/api/generate
GRAMMARCHECK_OLLAMA_MODEL=gemma4

# Database
GRAMMARCHECK_DATABASE_URL=sqlite:///./grammarcheck.db

# Cache
GRAMMARCHECK_REDIS_URL=
GRAMMARCHECK_CACHE_TTL_SECONDS=3600
GRAMMARCHECK_CACHE_MAX_SIZE=256

# Rate limiting
GRAMMARCHECK_RATE_LIMIT_PER_MINUTE=20

# API key (optional — disabled by default)
GRAMMARCHECK_ENABLE_API_KEY=false
GRAMMARCHECK_API_KEY=

# Logging
GRAMMARCHECK_LOG_LEVEL=INFO
GRAMMARCHECK_LOG_FILE=

# Limits
GRAMMARCHECK_MAX_INPUT_LENGTH=5000
GRAMMARCHECK_MAX_OUTPUT_LENGTH=10000

# Features
GRAMMARCHECK_ENABLE_METRICS=true
GRAMMARCHECK_ENABLE_EVAL=true
