  {"id": "core_060", "category": "punctuation", "difficulty": "easy", "input": "He said that he was tired but he kept working", "expected_corrected": "He said that he was tired, but he kept working.", "expected_errors": [{"original": "tired but", "corrected": "tired, but", "type": "punctuation", "reason_keywords": ["comma", "conjunction"]}], "expected_error_count": 1, "notes": ""},
  {"id": "core_061", "category": "word_choice", "difficulty": "easy", "input": "Their going to there house over they're.", "expected_corrected": "They're going to their house over there.", "expected_errors": [{"original": "Their", "corrected": "They're", "type": "word_choice", "reason_keywords": ["homophone", "contraction"]}, {"original": "there", "corrected": "their", "type": "word_choice", "reason_keywords": ["homophone", "possessive"]}, {"original": "they're", "corrected": "there", "type": "word_choice", "reason_keywords": ["homophone", "location"]}], "expected_error_count": 3, "notes": "Their/they're/there confusion"},
  {"id": "core_062", "category": "word_choice", "difficulty": "easy", "input": "Its time to put it in it's place.", "expected_corrected": "It's time to put it in its place.", "expected_errors": [{"original": "Its", "corrected": "It's", "type": "word_choice", "reason_keywords": ["apostrophe", "contraction"]}, {"original": "it's", "corrected": "its", "type": "word_choice", "reason_keywords": ["possessive", "no apostrophe"]}], "expected_error_count": 2, "notes": "Its/it's confusion"},
  {"id": "core_063", "category": "word_choice", "difficulty": "medium", "input": "The affects of the medicine effected her quickly.", "expected_corrected": "The effects of the medicine affected her quickly.", "expected_errors": [{"original": "affects", "corrected": "effects", "type": "word_choice", "reason_keywords": ["affect vs effect"]}, {"original": "effected", "corrected": "affected", "type": "word_choice", "reason_keywords": ["affect vs effect"]}], "expected_error_count": 2, "notes": "Affect/effect confusion"},
  {"id": "core_064", "category": "word_choice", "difficulty": "medium", "input": "She excepted all the complements graciously.", "expected_corrected": "She accepted all the compliments graciously.", "expected_errors": [{"original": "excepted", "corrected": "accepted", "type": "word_choice", "reason_keywords": ["accept vs except"]}, {"original": "complements", "corrected": "compliments", "type": "word_choice", "reason_keywords": ["complement vs compliment"]}], "expected_error_count": 2, "notes": ""},
  {"id": "core_065", "category": "word_choice", "difficulty": "medium", "input": "He past the principle's office every morning.", "expected_corrected": "He passed the principal's office every morning.", "expected_errors": [{"original": "past", "corrected": "passed", "type": "word_choice", "reason_keywords": ["past vs passed"]}, {"original": "principle", "corrected": "principal", "type": "word_choice", "reason_keywords": ["principal vs principle"]}], "expected_error_count": 2, "notes": ""},
  {"id": "core_066", "category": "word_choice", "difficulty": "hard", "input": "The weather whether she goes or not is fare.", "expected_corrected": "The question whether she goes or not is fair.", "expected_errors": [{"original": "weather", "corrected": "question", "type": "word_choice", "reason_keywords": ["weather vs whether"]}, {"original": "fare", "corrected": "fair", "type": "word_choice", "reason_keywords": ["fair vs fare"]}], "expected_error_count": 2, "notes": "Weather/whether and fair/fare — tricky"},
  {"id": "core_067", "category": "word_choice", "difficulty": "easy", "input": "They're car needs it's breaks repaired.", "expected_corrected": "Their car needs its brakes repaired.", "expected_errors": [{"original": "They're", "corrected": "Their", "type": "word_choice", "reason_keywords": ["homophone", "possessive"]}, {"original": "it's", "corrected": "its", "type": "word_choice", "reason_keywords": ["possessive", "no apostrophe"]}, {"original": "breaks", "corrected": "brakes", "type": "word_choice", "reason_keywords": ["homophone", "break vs brake"]}], "expected_error_count": 3, "notes": ""},
  {"id": "core_068", "category": "word_choice", "difficulty": "hard", "input": "She adviced him to advice the council.", "expected_corrected": "She advised him to advise the council.", "expected_errors": [{"original": "adviced", "corrected": "advised", "type": "word_choice", "reason_keywords": ["advice vs advise", "noun vs verb"]}, {"original": "advice", "corrected": "advise", "type": "word_choice", "reason_keywords": ["advice vs advise", "noun vs verb"]}], "expected_error_count": 2, "notes": "Advice/advise confusion"},
  {"id": "core_069", "category": "word_choice", "difficulty": "medium", "input": "The stationary bike was stationery in the gym.", "expected_corrected": "The stationary bike was stationary in the gym.", "expected_errors": [{"original": "stationary", "corrected": "stationary", "type": "spelling", "reason_keywords": ["stationary vs stationery"]}, {"original": "stationery", "corrected": "stationary", "type": "word_choice", "reason_keywords": ["stationary vs stationery"]}], "expected_error_count": 2, "notes": "Stationary/stationery — same pronunciation"},
  {"id": "core_070", "category": "word_choice", "difficulty": "hard", "input": "He poured over the book for hours.", "expected_corrected": "He pored over the book for hours.", "expected_errors": [{"original": "poured", "corrected": "pored", "type": "word_choice", "reason_keywords": ["pour vs pore", "homophone"]}], "expected_error_count": 1, "notes": "Pour/pore — very tricky"},
